{
  "name": "urlume",
  "version": "0.1.0",
  "description": "URL → product video. Turn any website into a beautiful AI-powered explainer video.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "video",
    "ai",
    "saas",
    "explainer",
    "product-video",
    "marketing",
    "cli",
    "playwright",
    "ffmpeg"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "urlume": "./dist/cli.js"
  },
  "files": [
    "dist",
    "runtime",
    "Skills",
    "assets",
    "scripts/postinstall.mjs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "extract": "node scripts/extract-runtime.mjs",
    "extract:check": "node scripts/extract-runtime.mjs --check",
    "urlume": "tsx src/cli.ts",
    "compile:demo": "tsx src/compiler/cli.ts examples/demo-film/storyboard.json",
    "render:demo": "tsx src/renderer/cli.ts examples/demo-film/index.html --out examples/demo-film/out/demo.mp4",
    "render:smoke": "tsx src/renderer/cli.ts examples/demo-film/index.html --out examples/demo-film/out/smoke.mp4 --from 0 --to 30 --quality draft",
    "demo": "npm run compile:demo && npm run render:demo",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:browser": "vitest run tests/browser",
    "test:render": "vitest run tests/render",
    "test:mutation": "node tests/mutation/run.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "postinstall": "node scripts/postinstall.mjs",
    "prepack": "npm run extract:check && npm run build",
    "prepublishOnly": "npm run extract:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "commander": "^12.1.0",
    "ffmpeg-static": "^5.2.0",
    "ink": "^5.1.0",
    "ink-text-input": "^6.0.0",
    "openai": "^4.77.0",
    "playwright-core": "1.62.1",
    "react": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "playwright": "^1.49.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
